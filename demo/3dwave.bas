10 REM 3D WAVE - A SIN(D)/D SURFACE, TILTED 45 DEGREES ON EACH AXIS AND
20 REM TURNING AROUND ITS Y AXIS. PRESS ANY KEY TO STOP.
30 REM _AUTODISPLAY OFF AND _DISPLAY (FROM QB64) SHOW EACH FRAME WHOLE.
40 SCREEN 1: CLS: _AUTODISPLAY OFF
50 CX = 160: CY = 100: SCALE = 4
60 REM 45 DEGREES IN RADIANS
70 RX = 0.7854: RY = 0.7854: RZ = 0.7854
80 CRX = COS(RX): SRX = SIN(RX): CRZ = COS(RZ): SRZ = SIN(RZ)
90 REM THE HEIGHT OF THE SURFACE AT EACH POINT NEVER CHANGES
100 DIM H(50, 50)
110 FOR Z = -25 TO 25: FOR X = -25 TO 25
120   D = SQR(X*X + Z*Z)
130   H(X + 25, Z + 25) = 0: IF D > 0 THEN H(X + 25, Z + 25) = 12 * SIN(D) / D
140 NEXT X: NEXT Z
150 REM DRAW ONE FRAME
160 CLS
170 CRY = COS(RY): SRY = SIN(RY)
180 FOR Z = -25 TO 25 STEP 1
190   FIRST = 1
200   FOR X = -25 TO 25 STEP 1
210     Y = H(X + 25, Z + 25)
220     REM ROTATE AROUND Y AXIS
230     X1 = X * CRY - Z * SRY
240     Z1 = X * SRY + Z * CRY
250     REM ROTATE AROUND X AXIS
260     Y1 = Y * CRX - Z1 * SRX
270     REM ROTATE AROUND Z AXIS AND PROJECT
280     NX = CX + (X1 * CRZ - Y1 * SRZ) * SCALE: NY = CY - (X1 * SRZ + Y1 * CRZ) * SCALE
290     IF FIRST = 0 THEN LINE (PX,PY)-(NX,NY), 3
300     PX = NX: PY = NY: FIRST = 0
310   NEXT X
320 NEXT Z
330 LOCATE 23, 1: PRINT "3D WAVE - 45 DEGREE TRIPLE TILT"
340 _DISPLAY
350 REM TURN A LITTLE EACH FRAME, ONE FULL TURN EVERY 150 FRAMES
360 RY = RY + 6.2832 / 150: IF RY > 6.2832 THEN RY = RY - 6.2832
370 _LIMIT 30
380 IF INKEY$ = "" THEN 160
390 END
