10 REM MANDELBROT FRACTAL DEMO FOR GWBASIC / BASIKA
20 REM 640x480 RESOLUTION WITH 256 COLORS
30 SCREEN 12: CLS
40 DEFDBL A-H, O-Z
50 DEFINT I-N
60 MAXITER = 128
70 RMIN = -2.0: RMAX = 0.8
80 IMIN = -1.05: IMAX = 1.05
90 DR = (RMAX - RMIN) / 640.0
100 DI = (IMAX - IMIN) / 480.0
110 COLOR 15: LOCATE 1, 1: PRINT "GENERATING MANDELBROT FRACTAL (640x480, 256 COLORS)..."
120 FOR Y = 0 TO 479
130   CI = IMIN + Y * DI
140   FOR X = 0 TO 639
150     CR = RMIN + X * DR
160     ZR = 0.0: ZI = 0.0
170     ZR2 = 0.0: ZI2 = 0.0
180     K = 0
190     WHILE (ZR2 + ZI2 <= 4.0) AND (K < MAXITER)
200       ZI = 2.0 * ZR * ZI + CI
210       ZR = ZR2 - ZI2 + CR
220       ZR2 = ZR * ZR
230       ZI2 = ZI * ZI
240       K = K + 1
250     WEND
260     IF K = MAXITER THEN N = 0 ELSE N = (K * 3 + 16) MOD 256
270     PSET (X, Y), N
280   NEXT X
290 NEXT Y
300 COLOR 15: LOCATE 30, 1: PRINT "MANDELBROT SET (640x480, 256 COLORS) - GENERATION COMPLETE";
310 END

