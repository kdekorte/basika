' QB64-style alpha: drawing with an _RGBA32 color blends in a 32-bit image.
SCREEN _NEWIMAGE(640, 480, 32)
_AUTODISPLAY OFF
DIM PASS AS INTEGER
DIM RED AS _UNSIGNED LONG, BLUE AS _UNSIGNED LONG, WHITE AS _UNSIGNED LONG
DIM B1 AS _UNSIGNED LONG, C1 AS _UNSIGNED LONG, A1 AS _UNSIGNED LONG
PASS = 1
RED = _RGB32(255, 0, 0)
BLUE = _RGB32(0, 0, 255)
WHITE = _RGB32(255, 255, 255)
LINE (0, 0)-(639, 479), WHITE, BF

' PSET: alpha 0 leaves the pixel, 255 replaces it, 128 blends.
LINE (30, 30)-(32, 30), _RGB32(0, 0, 0), BF
PSET (30, 30), _RGBA32(255, 255, 255, 0)
IF POINT(30, 30) <> _RGB32(0, 0, 0) THEN PASS = 0
PSET (31, 30), _RGBA32(255, 255, 255, 255)
IF POINT(31, 30) <> WHITE THEN PASS = 0
PSET (32, 30), _RGBA32(255, 255, 255, 128)
P = _RED32(POINT(32, 30))
IF P < 120 OR P > 136 THEN PASS = 0

' LINE: a translucent line over black blends toward the line color.
LINE (100, 110)-(200, 110), _RGB32(0, 0, 0)
LINE (100, 110)-(200, 110), _RGBA32(255, 255, 255, 128)
L = _GREEN32(POINT(150, 110))
IF L < 120 OR L > 136 THEN PASS = 0
LINE (100, 120)-(200, 160), _RGBA32(255, 0, 0, 128), BF
LINE (240, 120)-(340, 180), _RGBA32(255, 0, 0, 128), B
LINE (400, 100)-(500, 200), BLUE, B
B1 = POINT(240, 150)
IF _RED32(B1) <> 255 OR _GREEN32(B1) < 120 OR _GREEN32(B1) > 136 THEN PASS = 0

' CIRCLE outline + PAINT with a translucent fill color.
CIRCLE (160, 280), 60, RED
PAINT (160, 280), _RGBA32(255, 0, 0, 128), RED
C1 = POINT(160, 280)
IF _RED32(C1) <> 255 OR _BLUE32(C1) < 120 OR _BLUE32(C1) > 136 THEN PASS = 0
IF POINT(160, 220) <> RED THEN PASS = 0

' PAINT: a translucent fill over black blends with what is already there.
LINE (280, 220)-(400, 340), BLUE, B
LINE (290, 230)-(390, 330), _RGB32(0, 0, 0), BF
LINE (290, 230)-(390, 330), BLUE, B
PAINT (300, 240), _RGBA32(0, 255, 0, 128), BLUE
A1 = POINT(320, 250)
IF _GREEN32(A1) < 120 OR _GREEN32(A1) > 136 OR _RED32(A1) <> 0 THEN PASS = 0

' The alpha of drawn pixels reads back as opaque.
IF _ALPHA32(POINT(320, 250)) <> 255 THEN PASS = 0
_DISPLAY
SCREENSHOT "tests/drawing_alpha.png"
OPEN "tests/drawing_alpha.result" FOR OUTPUT AS #1
PRINT #1, PASS
CLOSE #1
END
