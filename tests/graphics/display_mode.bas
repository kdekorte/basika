' _DISPLAY stops automatic presents until _AUTODISPLAY, as in QB64.
PRINT "start"; _AUTODISPLAY
_DISPLAY
PRINT "after _DISPLAY"; _AUTODISPLAY
_AUTODISPLAY
PRINT "after _AUTODISPLAY"; _AUTODISPLAY
_AUTODISPLAY OFF
PRINT "after OFF"; _AUTODISPLAY
_AUTODISPLAY ON: PRINT "after ON"; _AUTODISPLAY
IF _AUTODISPLAY THEN _DISPLAY
PRINT "after IF"; _AUTODISPLAY
_AUTODISPLAY ' comment
PRINT "after comment"; _AUTODISPLAY
