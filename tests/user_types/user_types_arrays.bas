10 TYPE Cell
20 VALUE AS INTEGER
30 END TYPE
40 TYPE Board
50 CELLS(1 TO 2) AS Cell
60 LABELS(1 TO 2) AS STRING * 4
70 SCORES(2) AS INTEGER
80 END TYPE
90 TYPE Point
100 X AS INTEGER
110 END TYPE
120 OPTION BASE 1
130 DIM B AS Board
140 B.CELLS(2).VALUE = 27
150 B.LABELS(1) = "AB"
160 B.SCORES(2) = 91
170 DIM POINTS(2) AS Point
180 POINTS(2).X = 42
190 PRINT LTRIM$(STR$(B.CELLS(2).VALUE)); ","; B.LABELS(1); ","; LTRIM$(STR$(B.SCORES(2)))
200 PRINT LTRIM$(STR$(POINTS(2).X))
210 END
