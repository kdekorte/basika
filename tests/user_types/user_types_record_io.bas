10 TYPE DiskRecord
20 CODE AS INTEGER
30 VALUE AS SINGLE
40 POSITION AS Position
50 LABEL AS STRING * 4
60 SAMPLES(1 TO 2) AS INTEGER
70 END TYPE
80 TYPE Position
90 LEVEL AS INTEGER
100 END TYPE
110 DIM SOURCE AS DiskRecord
120 DIM DESTINATION AS DiskRecord
130 SOURCE.CODE = -123
140 SOURCE.VALUE = 1.5
150 SOURCE.POSITION.LEVEL = 8
160 SOURCE.LABEL = "OK"
170 SOURCE.SAMPLES(2) = 44
180 OPEN "tests/user_types_record.tmp" FOR RANDOM AS #1
190 PUT #1, 1, SOURCE
200 SOURCE.CODE = 0
210 SOURCE.VALUE = 0
220 SOURCE.POSITION.LEVEL = 0
230 SOURCE.LABEL = ""
240 SOURCE.SAMPLES(2) = 0
250 GET #1, 1, DESTINATION
260 CLOSE #1
270 PRINT LTRIM$(STR$(DESTINATION.CODE)); ","; LTRIM$(STR$(DESTINATION.VALUE)); ","; LTRIM$(STR$(DESTINATION.POSITION.LEVEL)); ","; DESTINATION.LABEL; ","; LTRIM$(STR$(DESTINATION.SAMPLES(2)))
280 END
