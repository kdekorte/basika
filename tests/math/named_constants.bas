10 REM Named constants (CONST) tests
20 CONST PI = 3.14159
30 CONST E = 2.718281828
40 CONST MAXVAL = 100
50 PRINT "PI ="; PI
60 PRINT "E ="; E
70 PRINT "MAXVAL ="; MAXVAL
80 PRINT "2*PI ="; 2 * PI
90 PRINT "PI + E ="; PI + E
100 CONST S = 5 + 3 * 2
110 PRINT "S (5+3*2) ="; S
120 CONST SIZE = 5
130 DIM A(SIZE)
140 FOR I = 1 TO SIZE
150 A(I) = I * I
160 NEXT I
170 FOR I = 1 TO SIZE
180 PRINT A(I);
190 NEXT I
200 PRINT
210 CONST D = 10
220 FOR I = 1 TO D STEP 3
230 PRINT I;
240 NEXT I
250 PRINT
260 DEF FNSQR(X) = X * X
270 PRINT "FNSQR(PI) ="; FNSQR(PI)
280 REM Constants are cleared on RUN
290 END
