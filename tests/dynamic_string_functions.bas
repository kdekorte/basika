10 A$ = STRING$(1048576, "a")
20 PAD$ = "  " + A$ + "  "
30 U$ = UCASE$(A$)
40 L$ = LCASE$(U$)
50 T$ = TRIM$(PAD$)
60 LT$ = LTRIM$(PAD$)
70 RT$ = RTRIM$(PAD$)
80 IF LEN(U$) = 1048576 THEN PRINT "UCASE LENGTH PASS"
90 IF LEFT$(U$, 1) = "A" THEN PRINT "LEFT PASS"
100 IF RIGHT$(U$, 1) = "A" THEN PRINT "RIGHT PASS"
110 IF MID$(U$, 1048576, 1) = "A" THEN PRINT "MID PASS"
120 IF LEN(L$) = 1048576 THEN PRINT "LCASE LENGTH PASS"
130 IF LEN(T$) = 1048576 THEN PRINT "TRIM LENGTH PASS"
140 IF LEN(LT$) = 1048578 THEN PRINT "LTRIM LENGTH PASS"
150 IF LEN(RT$) = 1048578 THEN PRINT "RTRIM LENGTH PASS"
160 IF INSTR(A$, "aaa") = 1 THEN PRINT "INSTR PASS"
170 IF ASC(A$) = 97 THEN PRINT "ASC PASS"
180 END
